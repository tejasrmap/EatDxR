rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (required)
    //   - photoURL: string (required)
    //   - bio: string (optional)
    //   - favoriteCuisines: list (optional)
    //   - stats: map (required)
    //
    // Collection: restaurants
    // Document ID: restaurantId
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - cuisine: string (required)
    //   - location: string (required)
    //   - rating: number (required)
    //   - reviewCount: int (required)
    //   - image: string (optional)
    //
    // Collection: reviews
    // Document ID: reviewId
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - userName: string (required)
    //   - userPhoto: string (required)
    //   - restaurantId: string (required)
    //   - restaurantName: string (required)
    //   - dishes: list (required)
    //   - rating: number (required)
    //   - content: string (required)
    //   - createdAt: timestamp (required)
    //   - likes: int (required)
    //   - image: string (optional)
    //
    // Collection: lists
    // Document ID: listId
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - title: string (required)
    //   - description: string (optional)
    //   - restaurantIds: list (required)
    //   - likes: int (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "tejag.vijay@gmail.com" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin');
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL']) &&
             hasOnlyAllowedFields(['uid', 'displayName', 'photoURL', 'username', 'pronouns', 'bio', 'favoriteCuisines', 'stats']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 200 &&
             data.photoURL is string && data.photoURL.size() > 0 && data.photoURL.size() < 2000 &&
             (!('username' in data) || (data.username is string && data.username.size() < 30)) &&
             (!('pronouns' in data) || (data.pronouns is string && data.pronouns.size() < 20)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 1000)) &&
             (!('favoriteCuisines' in data) || (data.favoriteCuisines is list && data.favoriteCuisines.size() < 50));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userPhoto', 'restaurantId', 'restaurantName', 'dishes', 'rating', 'content', 'createdAt', 'likes']) &&
             hasOnlyAllowedFields(['id', 'userId', 'userName', 'userPhoto', 'restaurantId', 'restaurantName', 'dishes', 'rating', 'content', 'createdAt', 'likes']) &&
             data.id is string && data.id.size() > 0 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 200 &&
             data.userPhoto is string && data.userPhoto.size() > 0 && data.userPhoto.size() < 2000 &&
             data.restaurantId is string && data.restaurantId.size() > 0 &&
             data.restaurantName is string && data.restaurantName.size() > 0 && data.restaurantName.size() < 300 &&
             data.dishes is list && data.dishes.size() > 0 && data.dishes.size() < 20 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.content is string && data.content.size() < 10000 &&
             data.createdAt is timestamp &&
             data.likes is int && data.likes >= 0;
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll(['id', 'name', 'cuisine', 'location']) &&
             hasOnlyAllowedFields(['id', 'name', 'cuisine', 'location', 'rating', 'reviewCount', 'image']) &&
             data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 300 &&
             data.cuisine is string && data.cuisine.size() > 0 && data.cuisine.size() < 200 &&
             data.location is string && data.location.size() > 0 && data.location.size() < 1000 &&
             (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
             (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0)) &&
             (!('image' in data) || (data.image is string && data.image.size() < 2000));
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['id', 'reviewId', 'userId', 'userName', 'userPhoto', 'type', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.reviewId is string && data.reviewId.size() > 0 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 &&
             data.userPhoto is string &&
             data.type in ['LIKE', 'COMMENT'] &&
             (!('content' in data) || (data.content is string && data.content.size() > 0 && data.content.size() < 2000)) &&
             data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientId', 'actorId', 'actorName', 'actorPhoto', 'type', 'read', 'createdAt']) &&
             hasOnlyAllowedFields(['id', 'recipientId', 'actorId', 'actorName', 'actorPhoto', 'type', 'targetId', 'read', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.recipientId is string && data.recipientId.size() > 0 &&
             data.actorId == request.auth.uid &&
             data.actorName is string && data.actorName.size() > 0 &&
             data.actorPhoto is string &&
             data.type in ['LIKE', 'COMMENT', 'FOLLOW'] &&
             (!('targetId' in data) || (data.targetId is string)) &&
             data.read is bool &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.uid == resource.data.uid;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidReview(request.resource.data);
      allow update: if isDocOwner() && isValidReview(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /lists/{listId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isDocOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /interactions/{interactionId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidInteraction(request.resource.data);
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/reviews/$(resource.data.reviewId)).data.userId == request.auth.uid
      );
    }

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || resource.data.actorId == request.auth.uid);
    }
  }
}
